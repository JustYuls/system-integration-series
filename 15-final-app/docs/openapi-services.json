  "components": {
    "schemas": {
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "example": 500
          },
          "currency": {
            "type": "string",
            "example": "USD"
          }
        }
      },
      "EventRequest": {
        "type": "object",
        "required": [
          "requestNo",
          "title",
          "organization",
          "date",
          "status",
          "venue",
          "attendees",
          "budget",
          "outdoor",
          "contactEmail"
        ],
        "properties": {
          "requestNo": {
            "type": "string",
            "example": "EVT-0001"
          },
          "title": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "On hold",
              "Approved",
              "Returned"
            ]
          },
          "venue": {
            "type": "string",
            "example": "Gym"
          },
          "attendees": {
            "type": "integer"
          },
          "budget": {
            "$ref": "#/components/schemas/Money"
          },
          "outdoor": {
            "type": "boolean"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "NewEventRequest": {
        "type": "object",
        "required": [
          "title",
          "organization",
          "date",
          "venue",
          "attendees",
          "budget",
          "contactEmail"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "venue": {
            "type": "string"
          },
          "attendees": {
            "type": "integer",
            "minimum": 1
          },
          "budget": {
            "$ref": "#/components/schemas/Money"
          },
          "outdoor": {
            "type": "boolean",
            "default": false
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "StatusChange": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "On hold",
              "Approved",
              "Returned"
            ]
          }
        }
      },
      "Deposit": {
        "type": "object",
        "required": [
          "requestNo",
          "balancePhp"
        ],
        "properties": {
          "requestNo": {
            "type": "string"
          },
          "balancePhp": {
            "type": "number",
            "description": "Still unpaid, in pesos; 0 means paid"
          }
        }
      },
      "NewPayment": {
        "type": "object",
        "required": [
          "amountPhp"
        ],
        "properties": {
          "amountPhp": {
            "type": "number",
            "minimum": 0.01
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": [
          "id",
          "requestNo",
          "amountPhp",
          "balancePhp"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "requestNo": {
            "type": "string"
          },
          "amountPhp": {
            "type": "number"
          },
          "balancePhp": {
            "type": "number",
            "description": "The balance after this payment"
          }
        }
      },
      "Venue": {
        "type": "object",
        "required": [
          "id",
          "name",
          "capacity",
          "outdoor",
          "penaltyPhp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "gym"
          },
          "name": {
            "type": "string",
            "example": "Gym"
          },
          "capacity": {
            "type": "integer"
          },
          "outdoor": {
            "type": "boolean"
          },
          "penaltyPhp": {
            "type": "number",
            "description": "Unpaid facility penalty in pesos"
          }
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "venue",
          "date",
          "available",
          "capacityOk",
          "penaltyPhp",
          "reasons"
        ],
        "properties": {
          "venue": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "available": {
            "type": "boolean"
          },
          "capacityOk": {
            "type": "boolean"
          },
          "penaltyPhp": {
            "type": "number"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Reservation": {
        "type": "object",
        "required": [
          "requestNo",
          "venueId",
          "date",
          "hours"
        ],
        "properties": {
          "requestNo": {
            "type": "string"
          },
          "venueId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string"
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Fields that were not sent (400)"
              },
              "invalid": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Fields with a value that is not acceptable (400)"
              }
            }
          }
        }
      }
    }
  }
}
