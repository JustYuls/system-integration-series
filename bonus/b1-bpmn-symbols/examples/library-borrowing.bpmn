<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="http://campus.example/bpmn-symbols">
  <process id="library_borrowing" name="Library borrowing" isExecutable="false">
    <laneSet id="lanes">
      <lane id="L1" name="Student"><flowNodeRef>S1</flowNodeRef><flowNodeRef>T01</flowNodeRef><flowNodeRef>E1</flowNodeRef><flowNodeRef>E2</flowNodeRef></lane>
      <lane id="L2" name="Library System"><flowNodeRef>T02</flowNodeRef><flowNodeRef>G1</flowNodeRef><flowNodeRef>T04</flowNodeRef></lane>
      <lane id="L3" name="Librarian"><flowNodeRef>T03</flowNodeRef><flowNodeRef>T05</flowNodeRef></lane>
    </laneSet>
    <startEvent id="S1" name="Book wanted"/>
    <userTask id="T01" name="Show library card"/>
    <serviceTask id="T02" name="Check book availability"/>
    <exclusiveGateway id="G1" name="Book available?"/>
    <userTask id="T03" name="Hand over the book"/>
    <serviceTask id="T04" name="Record the loan"/>
    <userTask id="T05" name="Offer a reservation"/>
    <endEvent id="E1" name="Book borrowed"/>
    <endEvent id="E2" name="Reservation made"/>
    <sequenceFlow id="F01" sourceRef="S1" targetRef="T01"/>
    <sequenceFlow id="F02" sourceRef="T01" targetRef="T02"/>
    <sequenceFlow id="F03" sourceRef="T02" targetRef="G1"/>
    <sequenceFlow id="F04" name="Yes" sourceRef="G1" targetRef="T03"/>
    <sequenceFlow id="F05" name="No" sourceRef="G1" targetRef="T05"/>
    <sequenceFlow id="F06" sourceRef="T03" targetRef="T04"/>
    <sequenceFlow id="F07" sourceRef="T04" targetRef="E1"/>
    <sequenceFlow id="F08" sourceRef="T05" targetRef="E2"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
