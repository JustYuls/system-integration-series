      <bpmndi:BPMNEdge id="edge_F15" bpmnElement="F15"><di:waypoint x="1485" y="805"/><di:waypoint x="1539" y="805"/><di:waypoint x="1539" y="235"/><di:waypoint x="1593" y="235"/></bpmndi:BPMNEdge>
