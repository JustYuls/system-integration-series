      <bpmndi:BPMNShape id="shape_T07" bpmnElement="T07"><dc:Bounds x="1755" y="197" width="150" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_E1" bpmnElement="E1"><dc:Bounds x="2020" y="85" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_F01" bpmnElement="F01"><di:waypoint x="170" y="105"/><di:waypoint x="285" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_F02" bpmnElement="F02"><di:waypoint x="435" y="105"/><di:waypoint x="489" y="105"/><di:waypoint x="489" y="235"/><di:waypoint x="543" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_F03" bpmnElement="F03"><di:waypoint x="597" y="235"/><di:waypoint x="705" y="235"/></bpmndi:BPMNEdge>
