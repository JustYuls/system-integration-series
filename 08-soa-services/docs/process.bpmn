      <bpmndi:BPMNEdge id="edge_F06" bpmnElement="F06"><di:waypoint x="597" y="235"/><di:waypoint x="651" y="235"/><di:waypoint x="651" y="565"/><di:waypoint x="705" y="565"/></bpmndi:BPMNEdge>
