      <bpmndi:BPMNEdge id="edge_F12" bpmnElement="F12"><di:waypoint x="1227" y="235"/><di:waypoint x="1281" y="235"/><di:waypoint x="1281" y="695"/><di:waypoint x="1335" y="695"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_F13" bpmnElement="F13"><di:waypoint x="1227" y="235"/><di:waypoint x="1281" y="235"/><di:waypoint x="1281" y="805"/><di:waypoint x="1335" y="805"/></bpmndi:BPMNEdge>
